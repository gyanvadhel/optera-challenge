# Set ONE of these to run live. With neither set, run.py uses the
# deterministic offline simulator and labels the report SIMULATED.

# Google Gemini — free tier, no card required.
#   Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Anthropic Claude — prepaid credit.
#   Get a key: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides; defaults live in optera/config.py ---
# OPTERA_GEMINI_ROUTER=gemini-3.1-flash-lite
# OPTERA_GEMINI_CHEAP=gemini-3.5-flash-lite
# OPTERA_GEMINI_BASELINE=gemini-3.6-flash
# OPTERA_GEMINI_ESCALATION=gemini-3.6-flash
# OPTERA_GEMINI_RPM=10          # free-tier pacing; raise on a paid key
